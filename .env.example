# =============================================================================
# Aperture MLOps — environment template
# Copy to .env and adjust. Never commit real secrets.
# =============================================================================

# --- Core --------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1
API_PREFIX=/api

# --- Database ----------------------------------------------------------------
# Local default (SQLite): sqlite:///./data/mlops.db
# Compose (Postgres):    postgresql+psycopg2://mlops:mlops@postgres:5432/mlops
DATABASE_URL=
# Create tables at startup. Disable in production and run `alembic upgrade head`.
AUTO_CREATE_TABLES=true

# --- MLflow ------------------------------------------------------------------
MLFLOW_ENABLED=true
# Local default: sqlite:///./data/mlflow.db
# Compose:       http://mlflow:5000
MLFLOW_TRACKING_URI=
# Local default is a file:// URI under DATA_DIR. Compose uses s3://mlflow/.
MLFLOW_ARTIFACT_ROOT=
MLFLOW_REGISTRY_ENABLED=true
MLFLOW_UI_URL=http://localhost:5000

# --- Storage -----------------------------------------------------------------
# local: application filesystem under ARTIFACT_DIR.
# s3: S3/MinIO via boto3 (used by Docker Compose).
STORAGE_BACKEND=local
ARTIFACT_DIR=
S3_ENDPOINT_URL=
S3_BUCKET=mlops-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# --- Background jobs ---------------------------------------------------------
# thread: in-process threads (local dev); sync: run inline (tests);
# celery: publish to Redis and run `celery -A app.workers.celery_app worker`.
JOB_RUNNER=thread
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_URL=

# --- Limits ------------------------------------------------------------------
MAX_UPLOAD_BYTES=52428800
MAX_DATASET_ROWS=200000
MAX_DATASET_COLUMNS=200
MAX_PREDICTION_BODY_BYTES=2097152
MAX_BATCH_SIZE=1000
JSON_BODY_LIMIT_BYTES=6291456

# --- Rate limits (requests per minute) ---------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_PREDICT_PER_MINUTE=240
RATE_LIMIT_API_PER_MINUTE=600

# --- Drift / monitoring ------------------------------------------------------
MIN_DRIFT_SAMPLES=30
DRIFT_ENGINE=evidently
DRIFT_ALPHA=0.05
DRIFT_PSI_THRESHOLD=0.2
DRIFT_SHARE_THRESHOLD=0.3
DEFAULT_MIN_LABEL_SAMPLES=30
PERFORMANCE_DEGRADATION_THRESHOLD=0.10
CAPTURE_MONITORING_SAMPLES=true
MONITORING_SAMPLE_RATE=1.0
# Deliberately off by default: raw prediction payloads may contain PII.
LOG_RAW_PREDICTION_INPUT=false

# --- Cookies -----------------------------------------------------------------
# Set COOKIE_SECURE=true when the frontend and API are served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Notifications (optional) ------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
ALERT_EMAIL_TO=
SLACK_WEBHOOK_URL=

# --- Demo --------------------------------------------------------------------
DEMO_MODE=true
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=
GIT_COMMIT=

# --- Frontend ----------------------------------------------------------------
# Public base URL of the API as seen by the browser.
# This is a build-time value for Next.js; rebuild the frontend after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# =============================================================================
# Docker Compose only — ignored by the local SQLite/thread-runner setup.
# Change every default password before exposing the stack.
# =============================================================================
POSTGRES_PASSWORD=mlops
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MLFLOW_PORT=5000
API_PORT=8000
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# The backend container applies Alembic migrations on start unless this is false.
RUN_MIGRATIONS=true
